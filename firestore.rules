rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'admin@gmail.com';
    }
    
    // ========== CONTENT COLLECTION ==========
    // Anyone can read website content
    // Only admin can write/update
    match /content/{document=**} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }
    
    // ========== NEWSLETTER SUBSCRIBERS ==========
    // Anyone can create (subscribe)
    // Only admin can read all subscribers
    match /newsletter_subscribers/{subscriberId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
      
      // Prevent duplicate subscriptions
      allow create: if request.resource.data.email is string &&
                      request.resource.data.email.size() > 0;
    }
    
    // ========== BLOG POSTS (Future Feature) ==========
    match /blog_posts/{postId} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }
    
    // ========== COURSES (Future Feature) ==========
    match /courses/{courseId} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }
    
    // ========== BOOKS ==========
    match /books/{bookId} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }
    
    // ========== CONTACT FORM SUBMISSIONS ==========
    match /contact_submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // ========== NEW SECTION COLLECTIONS ==========
    match /home/{document=**} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }
    match /research/{document=**} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }
    match /books/{document=**} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }
    match /consulting/{document=**} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }
    match /recognitions/{document=**} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }
    match /opinions/{document=**} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }
    match /courses/{document=**} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }
    match /contact/{document=**} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }
    match /siteConfig/{document=**} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }

    // ========== BLOGS ==========
    match /blogs/{document=**} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }

    // ========== TESTIMONIALS ==========
    match /testimonials/{document=**} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }

    // ========== TRAINING PARTNERS / LOGOS ==========
    match /training_partners/{document=**} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }

    // ========== NEWSLETTER CAMPAIGNS ==========
    match /newsletter_campaigns/{document=**} {
      allow read, write, update, delete: if isAdmin();
    }

    // ========== BLOG COMMENTS ==========
    match /blog_comments/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Block all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
